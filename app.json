{
  "expo": {
    "name": "Wanderly",
    "slug": "Wanderly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wanderly.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wanderly.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es", "ur"],
          "supportsRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F1513"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wanderly uses your location to show the weather where you are and places near you on the map. Your position is rounded before it is used to look up the forecast or nearby places."
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Wanderly uses the camera so you can take photos for your trips and activities. Photos stay on this device.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wanderly lets you choose photos from your library for your trips and activities, a trip's cover image or your profile photo. Photos are copied to this device only.",
          "cameraPermission": "Wanderly uses the camera so you can take photos for your trips and activities. Photos stay on this device.",
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "scheme": "wanderly",
    "experiments": {
      "typedRoutes": true
    }
  }
}
